# Local SQLite file (path is relative to the project root). Switch to a Postgres URL when deploying.
DATABASE_URL="file:./prisma/dev.db"

# Public origin of the app. Used for reset-password links and the CSRF origin allow-list.
APP_URL="http://localhost:3100"

# Optional: extra allowed origins for state-changing requests, comma-separated.
# TRUSTED_ORIGINS=""

# Optional: real email delivery via Resend. Without these, emails are printed to the server console (dev only).
# RESEND_API_KEY=""
# EMAIL_FROM="MystBook <hello@your-domain.com>"

# Optional: powers "Auto-fill" (Add Book) and "Find Cover" (Book Detail), both Google Books lookups. Without this,
# they still work against Google's shared keyless quota, which is small and can run dry. A free key (no billing
# needed) gives you your own private quota: console.cloud.google.com -> create/select a project -> APIs & Services
# > Library -> enable "Books API" -> APIs & Services > Credentials -> Create Credentials -> API key.
# GOOGLE_BOOKS_API_KEY=""
