# PostgreSQL connection string (Neon: use the pooled one, host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Optional: a direct (non-pooled) connection string, used only by `npm run db:deploy` / migrations.
# DIRECT_URL=""

# Only for `npm test`: any scratch PostgreSQL database. The tests use (and wipe) a schema named "test" inside it.
# TEST_DATABASE_URL=""

# Production only: Vercel Blob token for uploaded book covers (without it, covers are saved to local disk).
# BLOB_READ_WRITE_TOKEN=""

# Public origin of the app. Used for reset-password links and the CSRF origin allow-list.
APP_URL="http://localhost:3100"

# Optional: extra allowed origins for state-changing requests, comma-separated.
# TRUSTED_ORIGINS=""

# Optional: real email delivery via Resend. Without these, emails are printed to the server console (dev only).
# RESEND_API_KEY=""
# EMAIL_FROM="MystBook <hello@your-domain.com>"

# Optional: where "a new Mystery Book order was placed" emails are sent (needs the Resend settings above to be
# delivered for real; in development it is printed to the server console). Unset = no order emails.
# ORDER_NOTIFICATION_EMAIL="owner@example.com"

# Optional: powers "Auto-fill" (Add Book) and "Find Cover" (Book Detail), both Google Books lookups. Without this,
# they still work against Google's shared keyless quota, which is small and can run dry. A free key (no billing
# needed) gives you your own private quota: console.cloud.google.com -> create/select a project -> APIs & Services
# > Library -> enable "Books API" -> APIs & Services > Credentials -> Create Credentials -> API key.
# GOOGLE_BOOKS_API_KEY=""
